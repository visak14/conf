# ----------------------------------------------------
# Backend (.env located in /server)
# ----------------------------------------------------
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/github_analytics

# Optional: GitHub Personal Access Token
# Increases GitHub API rate limit from 60 req/hr to 5,000 req/hr
GITHUB_TOKEN=

# ----------------------------------------------------
# Frontend (.env.local located in /client)
# ----------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000/api
